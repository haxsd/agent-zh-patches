{
 "$comment": "UI 属性白名单与跳过规则。skipValues 是值级别的跳过正则，用来排除调试/内部名称。",
 "uiProps": [
  "label",
  "title",
  "description",
  "placeholder",
  "tooltip",
  "tooltipText",
  "ariaLabel",
  "aria-label",
  "text",
  "children",
  "message",
  "detail",
  "subtitle",
  "header",
  "hint",
  "helpText",
  "infoText",
  "errorText",
  "warningText",
  "emptyMessage",
  "emptyText",
  "emptyState",
  "confirmLabel",
  "cancelLabel",
  "buttonLabel",
  "buttonText",
  "actionLabel",
  "ctaLabel",
  "statusLabel",
  "sectionTitle",
  "dialogTitle",
  "caption",
  "summary",
  "heading",
  "promptText",
  "linkText"
 ],
 "uiPropSuffixes": [
  "Label",
  "Title",
  "Description",
  "Hint",
  "Placeholder",
  "Caption",
  "Message",
  "Tooltip",
  "Subtitle",
  "Header",
  "Detail",
  "Heading",
  "Summary"
 ],
 "idProps": [
  "id",
  "key",
  "code",
  "type",
  "role",
  "icon",
  "path",
  "url",
  "href",
  "src",
  "method",
  "action",
  "command",
  "commandId",
  "name",
  "value",
  "className",
  "class",
  "testId",
  "dataTestId",
  "scope",
  "kind",
  "variant",
  "scheme",
  "mimeType",
  "token"
 ],
 "limits": {
  "minLength": 2,
  "maxLength": 200,
  "contextLookback": 90,
  "maxAutoOccurrences": 12
 },
 "skipValues": [
  "^Monaco ",
  "^Decoration for ",
  "^(?:GPU|WebGPU) ",
  "\\b(?:buffer|pipeline|sampler|bind group|command encoder|render pass|shader module|texture view)$"
 ]
}
